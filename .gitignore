# Local credentials, environments, caches
.env
.env.*
!.env.example
.venv/
node_modules/
__pycache__/
*.py[cod]
.cache/
# WASM build intermediates; the rebuilt box.wasm and build-info.json ARE shipped.
/scraper/wasm/box/engine.wasm
/scraper/wasm/box/payload.bin
# Tagger work copies and logs, never the original DOCX/master data.
/output/tagger/.work/
/output/tagger/logs/

# Reproducible extraction/index support stays local; requested tagged outputs ship.
/output/tagger/*.source.txt
/output/tagger/*.paragraphs.jsonl
/output/tagger/*-first-*

# Paid MT results and derived comparison/annotation caches stay local.
/output/mt/

# Generated repair copy; the DOCX and its plain text stay the sources.
/input/*.damage-repaired.txt
